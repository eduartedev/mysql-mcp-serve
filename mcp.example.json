{
  "mcpServers": {
    "database": {
      "command": "npx",
      "args": ["-y", "@eduartedev/mysql-mcp-server"],
      "env": {
        "DB_ENGINE": "mysql",
        "DB_HOST": "localhost",
        "DB_PORT": "3306",
        "DB_USER": "app",
        "DB_PASSWORD": "tu_password",
        "DB_DATABASE": "tienda",
        "DB_ACCESS_MODE": "readonly",
        "DB_ALLOWED_DATABASES": "tienda,analytics:ro",
        "DB_PII_COLUMNS": "dni"
      }
    },
    "database-postgres-example": {
      "command": "npx",
      "args": ["-y", "@eduartedev/mysql-mcp-server"],
      "env": {
        "DB_HOST": "localhost",
        "DB_PORT": "5432",
        "DB_USER": "postgres",
        "DB_PASSWORD": "tu_password",
        "DB_DATABASE": "app",
        "DB_SCHEMA": "public",
        "DB_ACCESS_MODE": "readonly",
        "DB_ALLOWED_DATABASES": "public"
      }
    }
  }
}
