{
  "mcpServers": {
    "mysql-mcp-server": {
      "command": "npx",
      "args": ["-y", "@eduartedev/mysql-mcp-server"],
      "env": {
        "DB_ENGINE": "${DB_ENGINE}",
        "DB_HOST": "${DB_HOST}",
        "DB_PORT": "${DB_PORT}",
        "DB_USER": "${DB_USER}",
        "DB_PASSWORD": "${DB_PASSWORD}",
        "DB_DATABASE": "${DB_DATABASE}",
        "DB_SCHEMA": "${DB_SCHEMA}",
        "DB_ACCESS_MODE": "${DB_ACCESS_MODE}",
        "DB_ALLOWED_DATABASES": "${DB_ALLOWED_DATABASES}",
        "DB_PII_COLUMNS": "${DB_PII_COLUMNS}"
      }
    }
  }
}