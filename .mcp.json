{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "mysql-mcp-server": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@eduartedev/mysql-mcp-server"],
      "env": {
        "DB_HOST": "localhost",
        "DB_PORT": "3306",
        "DB_USER": "root",
        "DB_PASSWORD": "",
        "DB_DATABASE": "your_database",
        "DB_ACCESS_MODE": "readonly",
        "DB_ALLOWED_DATABASES": "",
        "DB_PII_COLUMNS": ""
      }
    }
  }
}