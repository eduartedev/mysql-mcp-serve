# Copia a .env y ajusta los valores. No subas .env a Git.

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=

# readonly es el defecto. Solo el valor exacto readwrite permite INSERT, UPDATE y DELETE.
MYSQL_ACCESS_MODE=readonly

# Vacío: no se puede cambiar de base. Lista: app,analytics:ro,logs:rw
MYSQL_ALLOWED_DATABASES=

# Extra column names to mask, comma-separated. email, phone, password, ssn, token and the Spanish equivalents are already included.
MYSQL_PII_COLUMNS=

# required activa TLS. Rutas a PEM en disco; no pegues el certificado en esta variable.
# MYSQL_SSL=required
# MYSQL_SSL_CA=
# MYSQL_SSL_CERT=
# MYSQL_SSL_KEY=
# MYSQL_SSL_REJECT_UNAUTHORIZED=true
