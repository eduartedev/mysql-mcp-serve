{
  "name": "@eduartedev/mysql-mcp-server",
  "version": "1.1.1",
  "description": "MCP server to query MySQL/MariaDB or PostgreSQL with validated SQL, read-only defaults, and PII masking",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mysql-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "assets/icon.svg",
    "README.md",
    "README.es.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eduartedev/mysql-mcp-serve.git"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js"
  },
  "keywords": ["mcp", "mysql", "postgresql", "mariadb", "database"],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "mysql2": "^3.11.0",
    "pg": "^8.13.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
